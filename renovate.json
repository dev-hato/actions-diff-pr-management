{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dev-hato/renovate-config"],
  "ignoreDeps": [
    "node-fetch",
    "@octokit/plugin-paginate-rest",
    "@octokit/plugin-rest-endpoint-methods"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ghalint\\.ya?ml$/"],
      "matchStrings": [
        "GHALINT_VERSION: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\s+GHALINT_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "suzuki-shunsuke/ghalint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
